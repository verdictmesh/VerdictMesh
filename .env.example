# Solana (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
VERDICT_MESH_PROGRAM_ID=8WyWpDD1ZbkTRGG6SRcYyWxApPsHaSgWn2SWJQ8xSgxq

# Публічний devnet-USDC (Circle). mintAuthority не наш — наповнювати присяжних
# можна лише з казначейського гаманця, поповненого заздалегідь із крану.
SETTLEMENT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Ключ ролі, що записує відбиток звіту. Єдиний привілейований ключ у системі;
# його повноваження обмежені інструкцією attest_report. Base58 secret key.
REPORTER_KEYPAIR=replace-me

# Казначейство, з якого роздається стейк присяжним (scripts/fund-jurors.ts).
# Поповнюється вручну з faucet.circle.com — mintAuthority мінта не наш.
TREASURY_KEYPAIR=replace-me

# AI-шар
ANTHROPIC_API_KEY=sk-ant-replace-me

# Supabase, порт 6543 (pgbouncer) обов'язковий при 2+ споживачах
DATABASE_URL=postgresql://user:pass@host:6543/postgres

PORT=8080
LOG_LEVEL=info
