          "value": "\"disputes\".\"reveal_deadline\" > \"disputes\".\"commit_deadline\""
        },
        "disputes_appeal_after_reveal": {
          "name": "disputes_appeal_after_reveal",
          "value": "\"disputes\".\"appeal_deadline\" = 0 or \"disputes\".\"appeal_deadline\" >= \"disputes\".\"reveal_deadline\""
        },
