{
  "name": "@verdictmesh/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Client for integrators of VerdictMesh, protocol-agnostic dispute resolution on Solana",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pda": "./src/pda.ts",
    "./vote": "./src/vote.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pda": {
        "types": "./dist/pda.d.ts",
        "default": "./dist/pda.js"
      },
      "./vote": {
        "types": "./dist/vote.d.ts",
        "default": "./dist/vote.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  }
}
